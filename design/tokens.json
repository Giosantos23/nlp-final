{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DocuERP — dark tech premium",
  "color": {
    "bg": "#0A0C10",
    "surface": "#11141A",
    "surface-2": "#171B22",
    "border": "#232934",
    "text": "#E7EAEE",
    "muted": "#8B94A3",
    "accent": "#10B981",
    "accent-2": "#34D399",
    "accent-glow": "rgba(16,185,129,.35)",
    "info": "#60A5FA",
    "warning": "#F5B544",
    "danger": "#F87171",
    "violet": "#A78BFA"
  },
  "semantic": {
    "answered": "accent",
    "abstained": "warning",
    "blocked": "danger",
    "human-review": "violet",
    "tool": "info"
  },
  "chart": {
    "series": ["#10B981", "#60A5FA", "#A78BFA", "#F5B544", "#F87171", "#34D399", "#8B94A3"],
    "baseline": "#8B94A3",
    "final": "#10B981",
    "grid": "#232934"
  },
  "font": {
    "sans": ["Geist", "Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
    "mono": ["Geist Mono", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
  },
  "font-size": {
    "xs": "12px",
    "sm": "13px",
    "base": "14px",
    "md": "16px",
    "lg": "20px",
    "xl": "28px",
    "2xl": "40px"
  },
  "radius": {
    "sm": "10px",
    "md": "12px",
    "lg": "14px",
    "pill": "999px"
  },
  "border-width": "1px",
  "shadow": {
    "soft": "0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35)",
    "glow": "0 0 0 1px rgba(16,185,129,.45), 0 0 24px rgba(16,185,129,.35)"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  }
}
