# Copiar a .env y completar. Nunca versionar .env.
# Autenticación del proveedor agent_sdk (suscripción de Claude Code, solo desarrollo/evaluación).
CLAUDE_CODE_OAUTH_TOKEN=
# Autenticación del proveedor anthropic_api (alternativa de producción).
ANTHROPIC_API_KEY=
# Proveedor LLM: agent_sdk | anthropic_api | offline | fake
DOCUERP_LLM_PROVIDER=agent_sdk
DOCUERP_LLM_MODEL=claude-haiku-5-5
DOCUERP_JUDGE_MODEL=claude-opus-5-5
# Secreto para firmar tokens de confirmación HITL (HMAC-SHA256).
DOCUERP_HMAC_SECRET=
